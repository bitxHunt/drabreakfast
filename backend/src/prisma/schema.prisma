generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// One fixed Telegram group per deployment, so no separate Chat/Membership model —
// isAdmin is a cache of Telegram's own admin list (see userModel.syncAdmins), refreshed
// periodically rather than trusted as a standalone source of truth.
model User {
  id        BigInt  @id // Telegram user id
  username  String?
  firstName String
  isAdmin   Boolean @default(false)

  // Running totals — see spec doc "Leaderboard": points never reset, streak resets on
  // a strike or a no-vote day, 3 strikes = kicked (reset policy for strikes still open).
  points  Int @default(0)
  streak  Int @default(0)
  strikes Int @default(0)

  createdAt DateTime @default(now())

  votes            Vote[]
  attendances      Attendance[]
  marshalSlots     SlotSession[] @relation("Marshal")
}

// One row per breakfast day (raw vote, independent of whether a SlotSession gets
// created) — slot is null for "not coming". See spec doc "Daily flow".
model Vote {
  id     String   @id @default(cuid())
  userId BigInt
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime @db.Date
  slot   String? // e.g. "07:00"; null = not coming

  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Created lazily for each (date, slot) that got at least one non-null vote. Holds the
// per-slot marshal assignment and submission state. See spec doc "Marshal rotation".
model SlotSession {
  id        String  @id @default(cuid())
  date      DateTime @db.Date
  slot      String

  marshalId BigInt?
  marshal   User?   @relation("Marshal", fields: [marshalId], references: [id])
  isStandIn Boolean @default(false)

  submitted   Boolean   @default(false)
  submittedAt DateTime?

  attendances Attendance[]

  @@unique([date, slot])
}

// One row per voter of a SlotSession — toggled true/false by the marshal pre-submit
// (see spec doc "Checklist"), locked once the session is submitted.
model Attendance {
  id        String      @id @default(cuid())
  userId    BigInt
  user      User        @relation(fields: [userId], references: [id])
  sessionId String
  session   SlotSession @relation(fields: [sessionId], references: [id])
  present   Boolean     @default(false)

  @@unique([userId, sessionId])
}
